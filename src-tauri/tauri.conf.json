{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDO",
  "version": "0.1.0",
  "identifier": "ch.aido.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --open=false",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "mono",
        "title": "AIDO-MONO",
        "url": "companion.html",
        "width": 220,
        "height": 228,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "chat",
        "title": "AIDO · Lokaler Chat",
        "url": "chat.html",
        "width": 480,
        "height": 640,
        "minWidth": 320,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
