{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDO",
  "version": "0.1.2",
  "identifier": "ch.aido.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --open=false",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "setup",
        "title": "AIDO einrichten",
        "url": "setup.html",
        "width": 640,
        "height": 660,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false
      },
      {
        "label": "tools",
        "title": "AIDO · Werkzeuge & Skills",
        "url": "tools.html",
        "width": 720,
        "height": 660,
        "minWidth": 360,
        "minHeight": 420,
        "center": true,
        "visible": false
      },
      {
        "label": "mono",
        "title": "AIDO-MONO",
        "url": "companion.html",
        "width": 220,
        "height": 228,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "chat",
        "title": "AIDO · Lokaler Chat",
        "url": "chat.html",
        "width": 480,
        "height": 640,
        "minWidth": 320,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../tooling/rea/node_modules/": "rea/node_modules/",
      "../tooling/rea/node.exe": "rea/node.exe",
      "../tooling/rea/NODE-LICENSE": "rea/NODE-LICENSE"
    },
    "windows": { "nsis": { "installMode": "currentUser", "compression": "zlib" } }
  }
}
